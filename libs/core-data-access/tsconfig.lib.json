{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    "paths": {
      "core-domain": ["../../dist/core-domain"],
      "@pleniu/core-domain": ["../../dist/core-domain"],
      "rules-types": ["../../dist/rules-types"],
      "@pleniu/rules-types": ["../../dist/rules-types"],
      "shared-http": ["../../dist/shared-http"],
      "@pleniu/shared-http": ["../../dist/shared-http"],
      "shared-auth": ["../../dist/shared-auth"],
      "@pleniu/shared-auth": ["../../dist/shared-auth"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}

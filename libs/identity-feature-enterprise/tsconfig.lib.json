/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    "paths": {
      "identity-data-access": ["../../dist/identity-data-access"],
      "@pleniu/identity-data-access": ["../../dist/identity-data-access"],
      "identity-domain": ["../../dist/identity-domain"],
      "@pleniu/identity-domain": ["../../dist/identity-domain"],
      "shared-auth": ["../../dist/shared-auth"],
      "@pleniu/shared-auth": ["../../dist/shared-auth"],
      "shared-http": ["../../dist/shared-http"],
      "@pleniu/shared-http": ["../../dist/shared-http"],
      "ui": ["../../dist/ui"],
      "@pleniu/ui": ["../../dist/ui"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
